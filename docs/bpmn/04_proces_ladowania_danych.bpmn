<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_4" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_DataLoading" name="Proces Ładowania Danych do Bazy" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Load" name="Start ładowania danych">
      <bpmn:outgoing>Flow_L1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:userTask id="Task_ChooseDBType" name="Wybór typu bazy danych">
      <bpmn:incoming>Flow_L1</bpmn:incoming>
      <bpmn:outgoing>Flow_L2</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:exclusiveGateway id="Gateway_DBType" name="Typ bazy?">
      <bpmn:incoming>Flow_L2</bpmn:incoming>
      <bpmn:outgoing>Flow_MySQL</bpmn:outgoing>
      <bpmn:outgoing>Flow_SQLServer</bpmn:outgoing>
      <bpmn:outgoing>Flow_MongoDB</bpmn:outgoing>
      <bpmn:outgoing>Flow_CosmosDB</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_MySQLConnection" name="Nawiązanie połączenia MySQL">
      <bpmn:incoming>Flow_MySQL</bpmn:incoming>
      <bpmn:outgoing>Flow_MySQL_Load</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SQLServerConnection" name="Nawiązanie połączenia SQL Server">
      <bpmn:incoming>Flow_SQLServer</bpmn:incoming>
      <bpmn:outgoing>Flow_SQLServer_Load</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_MongoDBConnection" name="Nawiązanie połączenia MongoDB">
      <bpmn:incoming>Flow_MongoDB</bpmn:incoming>
      <bpmn:outgoing>Flow_MongoDB_Load</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CosmosDBConnection" name="Nawiązanie połączenia CosmosDB">
      <bpmn:incoming>Flow_CosmosDB</bpmn:incoming>
      <bpmn:outgoing>Flow_CosmosDB_Load</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CheckSchema" name="Sprawdzenie/utworzenie schematu">
      <bpmn:incoming>Flow_MySQL_Load</bpmn:incoming>
      <bpmn:incoming>Flow_SQLServer_Load</bpmn:incoming>
      <bpmn:outgoing>Flow_L3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_LoadCSVtoSQL" name="Ładowanie plików CSV do tabel SQL">
      <bpmn:incoming>Flow_L3</bpmn:incoming>
      <bpmn:outgoing>Flow_L4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_LoadJSONtoMongo" name="Ładowanie plików JSON do kolekcji MongoDB">
      <bpmn:incoming>Flow_MongoDB_Load</bpmn:incoming>
      <bpmn:incoming>Flow_CosmosDB_Load</bpmn:incoming>
      <bpmn:outgoing>Flow_L5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_LoadSuccess">
      <bpmn:incoming>Flow_L4</bpmn:incoming>
      <bpmn:incoming>Flow_L5</bpmn:incoming>
      <bpmn:outgoing>Flow_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_VerifyData" name="Weryfikacja załadowanych danych">
      <bpmn:incoming>Flow_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_L6</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CreateIndexes" name="Utworzenie indeksów i optymalizacja">
      <bpmn:incoming>Flow_L6</bpmn:incoming>
      <bpmn:outgoing>Flow_L7</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_GenerateLoadReport" name="Generowanie raportu ładowania">
      <bpmn:incoming>Flow_L7</bpmn:incoming>
      <bpmn:outgoing>Flow_L8</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_LoadSuccess" name="Dane załadowane pomyślnie">
      <bpmn:incoming>Flow_L8</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_HandleError" name="Obsługa błędu ładowania">
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_L9</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_Rollback" name="Wycofanie zmian">
      <bpmn:incoming>Flow_L9</bpmn:incoming>
      <bpmn:outgoing>Flow_L10</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_LoadError" name="Ładowanie zakończone błędem">
      <bpmn:incoming>Flow_L10</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_L1" sourceRef="StartEvent_Load" targetRef="Task_ChooseDBType" />
    <bpmn:sequenceFlow id="Flow_L2" sourceRef="Task_ChooseDBType" targetRef="Gateway_DBType" />
    <bpmn:sequenceFlow id="Flow_MySQL" name="MySQL" sourceRef="Gateway_DBType" targetRef="Task_MySQLConnection" />
    <bpmn:sequenceFlow id="Flow_SQLServer" name="SQL Server" sourceRef="Gateway_DBType" targetRef="Task_SQLServerConnection" />
    <bpmn:sequenceFlow id="Flow_MongoDB" name="MongoDB" sourceRef="Gateway_DBType" targetRef="Task_MongoDBConnection" />
    <bpmn:sequenceFlow id="Flow_CosmosDB" name="CosmosDB" sourceRef="Gateway_DBType" targetRef="Task_CosmosDBConnection" />
    <bpmn:sequenceFlow id="Flow_MySQL_Load" sourceRef="Task_MySQLConnection" targetRef="Task_CheckSchema" />
    <bpmn:sequenceFlow id="Flow_SQLServer_Load" sourceRef="Task_SQLServerConnection" targetRef="Task_CheckSchema" />
    <bpmn:sequenceFlow id="Flow_MongoDB_Load" sourceRef="Task_MongoDBConnection" targetRef="Task_LoadJSONtoMongo" />
    <bpmn:sequenceFlow id="Flow_CosmosDB_Load" sourceRef="Task_CosmosDBConnection" targetRef="Task_LoadJSONtoMongo" />
    <bpmn:sequenceFlow id="Flow_L3" sourceRef="Task_CheckSchema" targetRef="Task_LoadCSVtoSQL" />
    <bpmn:sequenceFlow id="Flow_L4" sourceRef="Task_LoadCSVtoSQL" targetRef="Gateway_LoadSuccess" />
    <bpmn:sequenceFlow id="Flow_L5" sourceRef="Task_LoadJSONtoMongo" targetRef="Gateway_LoadSuccess" />
    <bpmn:sequenceFlow id="Flow_Success" name="Sukces" sourceRef="Gateway_LoadSuccess" targetRef="Task_VerifyData" />
    <bpmn:sequenceFlow id="Flow_Fail" name="Błąd" sourceRef="Gateway_LoadSuccess" targetRef="Task_HandleError" />
    <bpmn:sequenceFlow id="Flow_L6" sourceRef="Task_VerifyData" targetRef="Task_CreateIndexes" />
    <bpmn:sequenceFlow id="Flow_L7" sourceRef="Task_CreateIndexes" targetRef="Task_GenerateLoadReport" />
    <bpmn:sequenceFlow id="Flow_L8" sourceRef="Task_GenerateLoadReport" targetRef="EndEvent_LoadSuccess" />
    <bpmn:sequenceFlow id="Flow_L9" sourceRef="Task_HandleError" targetRef="Task_Rollback" />
    <bpmn:sequenceFlow id="Flow_L10" sourceRef="Task_Rollback" targetRef="EndEvent_LoadError" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_4">
    <bpmndi:BPMNPlane id="BPMNPlane_4" bpmnElement="Process_DataLoading">
      <bpmndi:BPMNShape id="StartEvent_Load_di" bpmnElement="StartEvent_Load">
        <dc:Bounds x="152" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChooseDBType_di" bpmnElement="Task_ChooseDBType">
        <dc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DBType_di" bpmnElement="Gateway_DBType" isMarkerVisible="true">
        <dc:Bounds x="390" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MySQLConnection_di" bpmnElement="Task_MySQLConnection">
        <dc:Bounds x="490" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SQLServerConnection_di" bpmnElement="Task_SQLServerConnection">
        <dc:Bounds x="490" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MongoDBConnection_di" bpmnElement="Task_MongoDBConnection">
        <dc:Bounds x="490" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CosmosDBConnection_di" bpmnElement="Task_CosmosDBConnection">
        <dc:Bounds x="490" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckSchema_di" bpmnElement="Task_CheckSchema">
        <dc:Bounds x="640" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadCSVtoSQL_di" bpmnElement="Task_LoadCSVtoSQL">
        <dc:Bounds x="790" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadJSONtoMongo_di" bpmnElement="Task_LoadJSONtoMongo">
        <dc:Bounds x="640" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LoadSuccess_di" bpmnElement="Gateway_LoadSuccess" isMarkerVisible="true">
        <dc:Bounds x="940" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifyData_di" bpmnElement="Task_VerifyData">
        <dc:Bounds x="1040" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateIndexes_di" bpmnElement="Task_CreateIndexes">
        <dc:Bounds x="1190" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateLoadReport_di" bpmnElement="Task_GenerateLoadReport">
        <dc:Bounds x="1340" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoadSuccess_di" bpmnElement="EndEvent_LoadSuccess">
        <dc:Bounds x="1490" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandleError_di" bpmnElement="Task_HandleError">
        <dc:Bounds x="1040" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rollback_di" bpmnElement="Task_Rollback">
        <dc:Bounds x="1190" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoadError_di" bpmnElement="EndEvent_LoadError">
        <dc:Bounds x="1340" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_L1_di" bpmnElement="Flow_L1">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_di" bpmnElement="Flow_L2">
        <di:waypoint x="340" y="220" />
        <di:waypoint x="390" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MySQL_di" bpmnElement="Flow_MySQL">
        <di:waypoint x="415" y="195" />
        <di:waypoint x="415" y="120" />
        <di:waypoint x="490" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SQLServer_di" bpmnElement="Flow_SQLServer">
        <di:waypoint x="440" y="220" />
        <di:waypoint x="490" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MongoDB_di" bpmnElement="Flow_MongoDB">
        <di:waypoint x="415" y="245" />
        <di:waypoint x="415" y="320" />
        <di:waypoint x="490" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CosmosDB_di" bpmnElement="Flow_CosmosDB">
        <di:waypoint x="415" y="245" />
        <di:waypoint x="415" y="420" />
        <di:waypoint x="490" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MySQL_Load_di" bpmnElement="Flow_MySQL_Load">
        <di:waypoint x="590" y="120" />
        <di:waypoint x="615" y="120" />
        <di:waypoint x="615" y="170" />
        <di:waypoint x="640" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SQLServer_Load_di" bpmnElement="Flow_SQLServer_Load">
        <di:waypoint x="590" y="220" />
        <di:waypoint x="615" y="220" />
        <di:waypoint x="615" y="170" />
        <di:waypoint x="640" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MongoDB_Load_di" bpmnElement="Flow_MongoDB_Load">
        <di:waypoint x="590" y="320" />
        <di:waypoint x="615" y="320" />
        <di:waypoint x="615" y="370" />
        <di:waypoint x="640" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CosmosDB_Load_di" bpmnElement="Flow_CosmosDB_Load">
        <di:waypoint x="590" y="420" />
        <di:waypoint x="615" y="420" />
        <di:waypoint x="615" y="370" />
        <di:waypoint x="640" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_di" bpmnElement="Flow_L3">
        <di:waypoint x="740" y="170" />
        <di:waypoint x="790" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L4_di" bpmnElement="Flow_L4">
        <di:waypoint x="890" y="170" />
        <di:waypoint x="915" y="170" />
        <di:waypoint x="915" y="270" />
        <di:waypoint x="940" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L5_di" bpmnElement="Flow_L5">
        <di:waypoint x="740" y="370" />
        <di:waypoint x="840" y="370" />
        <di:waypoint x="840" y="270" />
        <di:waypoint x="940" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Success_di" bpmnElement="Flow_Success">
        <di:waypoint x="990" y="270" />
        <di:waypoint x="1040" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fail_di" bpmnElement="Flow_Fail">
        <di:waypoint x="965" y="295" />
        <di:waypoint x="965" y="420" />
        <di:waypoint x="1040" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L6_di" bpmnElement="Flow_L6">
        <di:waypoint x="1140" y="270" />
        <di:waypoint x="1190" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L7_di" bpmnElement="Flow_L7">
        <di:waypoint x="1290" y="270" />
        <di:waypoint x="1340" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L8_di" bpmnElement="Flow_L8">
        <di:waypoint x="1440" y="270" />
        <di:waypoint x="1490" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L9_di" bpmnElement="Flow_L9">
        <di:waypoint x="1140" y="420" />
        <di:waypoint x="1190" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L10_di" bpmnElement="Flow_L10">
        <di:waypoint x="1290" y="420" />
        <di:waypoint x="1340" y="420" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
