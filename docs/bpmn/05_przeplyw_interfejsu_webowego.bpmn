      <bpmndi:BPMNShape id="Task_StreamProgress_di" bpmnElement="Task_StreamProgress">
        <dc:Bounds x="1040" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateUI_di" bpmnElement="Task_UpdateUI">
        <dc:Bounds x="1190" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DisplayResult_di" bpmnElement="Task_DisplayResult">
        <dc:Bounds x="1340" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ContinueAdmin_di" bpmnElement="Gateway_ContinueAdmin" isMarkerVisible="true">
        <dc:Bounds x="1490" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenDashboard_di" bpmnElement="Task_OpenDashboard">
        <dc:Bounds x="490" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadDashboard_di" bpmnElement="Task_LoadDashboard">
        <dc:Bounds x="640" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FetchData_di" bpmnElement="Task_FetchData">
        <dc:Bounds x="790" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RenderCharts_di" bpmnElement="Task_RenderCharts">
        <dc:Bounds x="940" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InteractDashboard_di" bpmnElement="Task_InteractDashboard">
        <dc:Bounds x="1090" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Web_di" bpmnElement="EndEvent_Web">
        <dc:Bounds x="1240" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_W1_di" bpmnElement="Flow_W1">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W2_di" bpmnElement="Flow_W2">
        <di:waypoint x="340" y="220" />
        <di:waypoint x="390" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Admin_di" bpmnElement="Flow_Admin">
        <di:waypoint x="415" y="195" />
        <di:waypoint x="415" y="120" />
        <di:waypoint x="490" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Dashboard_di" bpmnElement="Flow_Dashboard">
        <di:waypoint x="415" y="245" />
