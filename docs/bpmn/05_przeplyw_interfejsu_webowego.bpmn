      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GenSQL_di" bpmnElement="Flow_GenSQL">
        <di:waypoint x="815" y="95" />
        <di:waypoint x="815" y="60" />
        <di:waypoint x="890" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GenNoSQL_di" bpmnElement="Flow_GenNoSQL">
        <di:waypoint x="840" y="120" />
        <di:waypoint x="865" y="120" />
        <di:waypoint x="865" y="160" />
        <di:waypoint x="890" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LoadDB_di" bpmnElement="Flow_LoadDB">
        <di:waypoint x="815" y="145" />
        <di:waypoint x="815" y="260" />
