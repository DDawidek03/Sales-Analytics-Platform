        <di:waypoint x="815" y="360" />
        <di:waypoint x="890" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W5_di" bpmnElement="Flow_W5">
        <di:waypoint x="990" y="60" />
