        <di:waypoint x="1190" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C10_di" bpmnElement="Flow_C10">
        <di:waypoint x="1290" y="220" />
        <di:waypoint x="1340" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UploadDone_di" bpmnElement="Flow_UploadDone">
        <di:waypoint x="1365" y="245" />
