<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_7" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_DataValidation" name="Proces Walidacji i Weryfikacji Danych" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Validation" name="Start walidacji">
      <bpmn:outgoing>Flow_V1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_LoadDataForValidation" name="Wczytanie danych do walidacji">
      <bpmn:incoming>Flow_V1</bpmn:incoming>
      <bpmn:outgoing>Flow_V2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CheckFileExists" name="Sprawdzenie istnienia plików">
      <bpmn:incoming>Flow_V2</bpmn:incoming>
      <bpmn:outgoing>Flow_V3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_FilesExist" name="Pliki istnieją?">
      <bpmn:incoming>Flow_V3</bpmn:incoming>
      <bpmn:outgoing>Flow_FilesOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_FilesMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_ReportMissingFiles" name="Raport brakujących plików">
      <bpmn:incoming>Flow_FilesMissing</bpmn:incoming>
      <bpmn:outgoing>Flow_V4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_ValidationFail" name="Walidacja nieudana">
      <bpmn:incoming>Flow_V4</bpmn:incoming>
      <bpmn:incoming>Flow_V14</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_ValidateCSVStructure" name="Walidacja struktury CSV (kolumny, typy)">
      <bpmn:incoming>Flow_FilesOK</bpmn:incoming>
      <bpmn:outgoing>Flow_V5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CheckNullValues" name="Sprawdzenie wartości NULL">
      <bpmn:incoming>Flow_V5</bpmn:incoming>
      <bpmn:outgoing>Flow_V6</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ValidateDataTypes" name="Walidacja typów danych">
      <bpmn:incoming>Flow_V6</bpmn:incoming>
      <bpmn:outgoing>Flow_V7</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CheckRanges" name="Sprawdzenie zakresów wartości">
      <bpmn:incoming>Flow_V7</bpmn:incoming>
      <bpmn:outgoing>Flow_V8</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ValidateForeignKeys" name="Walidacja kluczy obcych i relacji">
      <bpmn:incoming>Flow_V8</bpmn:incoming>
      <bpmn:outgoing>Flow_V9</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CheckDuplicates" name="Sprawdzenie duplikatów">
      <bpmn:incoming>Flow_V9</bpmn:incoming>
      <bpmn:outgoing>Flow_V10</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ValidateBusinessRules" name="Walidacja reguł biznesowych">
      <bpmn:incoming>Flow_V10</bpmn:incoming>
      <bpmn:outgoing>Flow_V11</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CalculateStatistics" name="Obliczenie statystyk danych">
      <bpmn:incoming>Flow_V11</bpmn:incoming>
      <bpmn:outgoing>Flow_V12</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CollectValidationResults" name="Zebranie wyników walidacji">
      <bpmn:incoming>Flow_V12</bpmn:incoming>
      <bpmn:outgoing>Flow_V13</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_ValidationResult" name="Wszystkie testy przeszły?">
      <bpmn:incoming>Flow_V13</bpmn:incoming>
      <bpmn:outgoing>Flow_AllPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_SomeFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_GenerateErrorReport" name="Generowanie raportu błędów">
      <bpmn:incoming>Flow_SomeFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_V14</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_GenerateValidationReport" name="Generowanie raportu walidacji">
      <bpmn:incoming>Flow_AllPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_V15</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SaveValidationLog" name="Zapis logu walidacji">
      <bpmn:incoming>Flow_V15</bpmn:incoming>
      <bpmn:outgoing>Flow_V16</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_MarkDataAsValid" name="Oznaczenie danych jako zwalidowanych">
      <bpmn:incoming>Flow_V16</bpmn:incoming>
      <bpmn:outgoing>Flow_V17</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_ValidationSuccess" name="Dane zwalidowane pomyślnie">
      <bpmn:incoming>Flow_V17</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_V1" sourceRef="StartEvent_Validation" targetRef="Task_LoadDataForValidation" />
    <bpmn:sequenceFlow id="Flow_V2" sourceRef="Task_LoadDataForValidation" targetRef="Task_CheckFileExists" />
    <bpmn:sequenceFlow id="Flow_V3" sourceRef="Task_CheckFileExists" targetRef="Gateway_FilesExist" />
    <bpmn:sequenceFlow id="Flow_FilesOK" name="Tak" sourceRef="Gateway_FilesExist" targetRef="Task_ValidateCSVStructure" />
    <bpmn:sequenceFlow id="Flow_FilesMissing" name="Nie" sourceRef="Gateway_FilesExist" targetRef="Task_ReportMissingFiles" />
    <bpmn:sequenceFlow id="Flow_V4" sourceRef="Task_ReportMissingFiles" targetRef="EndEvent_ValidationFail" />
    <bpmn:sequenceFlow id="Flow_V5" sourceRef="Task_ValidateCSVStructure" targetRef="Task_CheckNullValues" />
    <bpmn:sequenceFlow id="Flow_V6" sourceRef="Task_CheckNullValues" targetRef="Task_ValidateDataTypes" />
    <bpmn:sequenceFlow id="Flow_V7" sourceRef="Task_ValidateDataTypes" targetRef="Task_CheckRanges" />
    <bpmn:sequenceFlow id="Flow_V8" sourceRef="Task_CheckRanges" targetRef="Task_ValidateForeignKeys" />
    <bpmn:sequenceFlow id="Flow_V9" sourceRef="Task_ValidateForeignKeys" targetRef="Task_CheckDuplicates" />
    <bpmn:sequenceFlow id="Flow_V10" sourceRef="Task_CheckDuplicates" targetRef="Task_ValidateBusinessRules" />
    <bpmn:sequenceFlow id="Flow_V11" sourceRef="Task_ValidateBusinessRules" targetRef="Task_CalculateStatistics" />
    <bpmn:sequenceFlow id="Flow_V12" sourceRef="Task_CalculateStatistics" targetRef="Task_CollectValidationResults" />
    <bpmn:sequenceFlow id="Flow_V13" sourceRef="Task_CollectValidationResults" targetRef="Gateway_ValidationResult" />
    <bpmn:sequenceFlow id="Flow_AllPassed" name="Tak" sourceRef="Gateway_ValidationResult" targetRef="Task_GenerateValidationReport" />
    <bpmn:sequenceFlow id="Flow_SomeFailed" name="Nie" sourceRef="Gateway_ValidationResult" targetRef="Task_GenerateErrorReport" />
    <bpmn:sequenceFlow id="Flow_V14" sourceRef="Task_GenerateErrorReport" targetRef="EndEvent_ValidationFail" />
    <bpmn:sequenceFlow id="Flow_V15" sourceRef="Task_GenerateValidationReport" targetRef="Task_SaveValidationLog" />
    <bpmn:sequenceFlow id="Flow_V16" sourceRef="Task_SaveValidationLog" targetRef="Task_MarkDataAsValid" />
    <bpmn:sequenceFlow id="Flow_V17" sourceRef="Task_MarkDataAsValid" targetRef="EndEvent_ValidationSuccess" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_7">
    <bpmndi:BPMNPlane id="BPMNPlane_7" bpmnElement="Process_DataValidation">
      <bpmndi:BPMNShape id="StartEvent_Validation_di" bpmnElement="StartEvent_Validation">
        <dc:Bounds x="152" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadDataForValidation_di" bpmnElement="Task_LoadDataForValidation">
        <dc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckFileExists_di" bpmnElement="Task_CheckFileExists">
        <dc:Bounds x="390" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FilesExist_di" bpmnElement="Gateway_FilesExist" isMarkerVisible="true">
        <dc:Bounds x="540" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReportMissingFiles_di" bpmnElement="Task_ReportMissingFiles">
        <dc:Bounds x="515" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ValidationFail_di" bpmnElement="EndEvent_ValidationFail">
        <dc:Bounds x="547" y="422" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateCSVStructure_di" bpmnElement="Task_ValidateCSVStructure">
        <dc:Bounds x="640" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckNullValues_di" bpmnElement="Task_CheckNullValues">
        <dc:Bounds x="790" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateDataTypes_di" bpmnElement="Task_ValidateDataTypes">
        <dc:Bounds x="940" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckRanges_di" bpmnElement="Task_CheckRanges">
        <dc:Bounds x="1090" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateForeignKeys_di" bpmnElement="Task_ValidateForeignKeys">
        <dc:Bounds x="1240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckDuplicates_di" bpmnElement="Task_CheckDuplicates">
        <dc:Bounds x="152" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateBusinessRules_di" bpmnElement="Task_ValidateBusinessRules">
        <dc:Bounds x="302" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalculateStatistics_di" bpmnElement="Task_CalculateStatistics">
        <dc:Bounds x="452" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CollectValidationResults_di" bpmnElement="Task_CollectValidationResults">
        <dc:Bounds x="602" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidationResult_di" bpmnElement="Gateway_ValidationResult" isMarkerVisible="true">
        <dc:Bounds x="752" y="335" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateErrorReport_di" bpmnElement="Task_GenerateErrorReport">
        <dc:Bounds x="727" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateValidationReport_di" bpmnElement="Task_GenerateValidationReport">
        <dc:Bounds x="852" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveValidationLog_di" bpmnElement="Task_SaveValidationLog">
        <dc:Bounds x="1002" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkDataAsValid_di" bpmnElement="Task_MarkDataAsValid">
        <dc:Bounds x="1152" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ValidationSuccess_di" bpmnElement="EndEvent_ValidationSuccess">
        <dc:Bounds x="1302" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_V1_di" bpmnElement="Flow_V1">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V2_di" bpmnElement="Flow_V2">
        <di:waypoint x="340" y="220" />
        <di:waypoint x="390" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V3_di" bpmnElement="Flow_V3">
        <di:waypoint x="490" y="220" />
        <di:waypoint x="540" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FilesOK_di" bpmnElement="Flow_FilesOK">
        <di:waypoint x="590" y="220" />
        <di:waypoint x="640" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FilesMissing_di" bpmnElement="Flow_FilesMissing">
        <di:waypoint x="565" y="245" />
        <di:waypoint x="565" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V4_di" bpmnElement="Flow_V4">
        <di:waypoint x="565" y="380" />
        <di:waypoint x="565" y="422" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V5_di" bpmnElement="Flow_V5">
        <di:waypoint x="740" y="220" />
        <di:waypoint x="790" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V6_di" bpmnElement="Flow_V6">
        <di:waypoint x="890" y="220" />
        <di:waypoint x="940" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V7_di" bpmnElement="Flow_V7">
        <di:waypoint x="1040" y="220" />
        <di:waypoint x="1090" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V8_di" bpmnElement="Flow_V8">
        <di:waypoint x="1190" y="220" />
        <di:waypoint x="1240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V9_di" bpmnElement="Flow_V9">
        <di:waypoint x="1290" y="260" />
        <di:waypoint x="1290" y="290" />
        <di:waypoint x="202" y="290" />
        <di:waypoint x="202" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V10_di" bpmnElement="Flow_V10">
        <di:waypoint x="252" y="360" />
        <di:waypoint x="302" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V11_di" bpmnElement="Flow_V11">
        <di:waypoint x="402" y="360" />
        <di:waypoint x="452" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V12_di" bpmnElement="Flow_V12">
        <di:waypoint x="552" y="360" />
        <di:waypoint x="602" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_V13_di" bpmnElement="Flow_V13">
