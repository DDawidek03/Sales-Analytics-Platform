<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_8" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_System">
    <bpmn:participant id="Participant_User" name="Użytkownik" processRef="Process_User" />
    <bpmn:participant id="Participant_WebApp" name="Aplikacja Webowa (Flask)" processRef="Process_WebApp" />
    <bpmn:participant id="Participant_DataGen" name="Moduł Generowania Danych" processRef="Process_DataGen" />
    <bpmn:participant id="Participant_Database" name="Bazy Danych" processRef="Process_Database" />
    
    <bpmn:messageFlow id="Flow_Msg1" sourceRef="Task_UserRequest" targetRef="Task_ReceiveRequest" />
    <bpmn:messageFlow id="Flow_Msg2" sourceRef="Task_CallGenerator" targetRef="Task_StartGeneration" />
    <bpmn:messageFlow id="Flow_Msg3" sourceRef="Task_StreamData" targetRef="Task_DisplayProgress" />
    <bpmn:messageFlow id="Flow_Msg4" sourceRef="Task_SaveData" targetRef="Task_StoreInDB" />
    <bpmn:messageFlow id="Flow_Msg5" sourceRef="Task_QueryData" targetRef="Task_FetchFromDB" />
    <bpmn:messageFlow id="Flow_Msg6" sourceRef="Task_ReturnResults" targetRef="Task_ShowDashboard" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_User" name="Proces Użytkownika" isExecutable="false">
    <bpmn:startEvent id="Start_User" name="Użytkownik otwiera aplikację">
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_UserRequest" name="Wysłanie żądania generowania danych">
      <bpmn:incoming>Flow_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_U2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_MonitorProgress" name="Monitorowanie postępu">
      <bpmn:incoming>Flow_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_U3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ViewDashboard" name="Przeglądanie dashboardu">
      <bpmn:incoming>Flow_U3</bpmn:incoming>
      <bpmn:outgoing>Flow_U4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="End_User" name="Zakończenie">
      <bpmn:incoming>Flow_U4</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_U1" sourceRef="Start_User" targetRef="Task_UserRequest" />
    <bpmn:sequenceFlow id="Flow_U2" sourceRef="Task_UserRequest" targetRef="Task_MonitorProgress" />
    <bpmn:sequenceFlow id="Flow_U3" sourceRef="Task_MonitorProgress" targetRef="Task_ViewDashboard" />
    <bpmn:sequenceFlow id="Flow_U4" sourceRef="Task_ViewDashboard" targetRef="End_User" />
  </bpmn:process>
  
  <bpmn:process id="Process_WebApp" name="Proces Aplikacji Webowej" isExecutable="false">
    <bpmn:task id="Task_ReceiveRequest" name="Odbiór żądania HTTP">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ValidateRequest" name="Walidacja parametrów">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CallGenerator" name="Wywołanie skryptu generowania">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_DisplayProgress" name="Wyświetlanie postępu w czasie rzeczywistym">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_QueryData" name="Zapytanie do bazy danych">
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ShowDashboard" name="Renderowanie dashboardu">
      <bpmn:incoming>Flow_A5</bpmn:incoming>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Task_ReceiveRequest" targetRef="Task_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_ValidateRequest" targetRef="Task_CallGenerator" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Task_CallGenerator" targetRef="Task_DisplayProgress" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Task_DisplayProgress" targetRef="Task_QueryData" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="Task_QueryData" targetRef="Task_ShowDashboard" />
  </bpmn:process>
  
  <bpmn:process id="Process_DataGen" name="Proces Generowania Danych" isExecutable="false">
    <bpmn:task id="Task_StartGeneration" name="Inicjalizacja generatora">
      <bpmn:outgoing>Flow_G1</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_GenerateEntities" name="Generowanie encji">
      <bpmn:incoming>Flow_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_StreamData" name="Strumieniowanie postępu">
      <bpmn:incoming>Flow_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SaveData" name="Zapis do plików CSV/JSON">
      <bpmn:incoming>Flow_G3</bpmn:incoming>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Flow_G1" sourceRef="Task_StartGeneration" targetRef="Task_GenerateEntities" />
    <bpmn:sequenceFlow id="Flow_G2" sourceRef="Task_GenerateEntities" targetRef="Task_StreamData" />
    <bpmn:sequenceFlow id="Flow_G3" sourceRef="Task_StreamData" targetRef="Task_SaveData" />
  </bpmn:process>
  
  <bpmn:process id="Process_Database" name="Proces Bazy Danych" isExecutable="false">
    <bpmn:task id="Task_StoreInDB" name="Zapis danych">
      <bpmn:outgoing>Flow_D1</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CreateIndexes" name="Utworzenie indeksów">
      <bpmn:incoming>Flow_D1</bpmn:incoming>
      <bpmn:outgoing>Flow_D2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_FetchFromDB" name="Pobranie danych">
      <bpmn:incoming>Flow_D2</bpmn:incoming>
      <bpmn:outgoing>Flow_D3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ReturnResults" name="Zwrócenie wyników">
      <bpmn:incoming>Flow_D3</bpmn:incoming>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Flow_D1" sourceRef="Task_StoreInDB" targetRef="Task_CreateIndexes" />
    <bpmn:sequenceFlow id="Flow_D2" sourceRef="Task_CreateIndexes" targetRef="Task_FetchFromDB" />
    <bpmn:sequenceFlow id="Flow_D3" sourceRef="Task_FetchFromDB" targetRef="Task_ReturnResults" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_8">
    <bpmndi:BPMNPlane id="BPMNPlane_8" bpmnElement="Collaboration_System">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1400" height="150" />
      </bpmndi:BPMNShape>
