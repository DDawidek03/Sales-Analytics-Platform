      <bpmndi:BPMNShape id="Task_ViewDashboard_di" bpmnElement="Task_ViewDashboard">
        <dc:Bounds x="1180" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_User_di" bpmnElement="End_User">
        <dc:Bounds x="1350" y="137" width="36" height="36" />
