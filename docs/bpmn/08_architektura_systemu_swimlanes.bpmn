      <bpmndi:BPMNShape id="Task_DisplayProgress_di" bpmnElement="Task_DisplayProgress">
        <dc:Bounds x="880" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_QueryData_di" bpmnElement="Task_QueryData">
        <dc:Bounds x="1030" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowDashboard_di" bpmnElement="Task_ShowDashboard">
        <dc:Bounds x="1330" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_StartGeneration_di" bpmnElement="Task_StartGeneration">
        <dc:Bounds x="580" y="455" width="100" height="80" />
