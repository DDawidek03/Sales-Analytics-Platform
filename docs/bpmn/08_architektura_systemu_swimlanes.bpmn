      <bpmndi:BPMNShape id="Task_GenerateEntities_di" bpmnElement="Task_GenerateEntities">
        <dc:Bounds x="730" y="455" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StreamData_di" bpmnElement="Task_StreamData">
        <dc:Bounds x="880" y="455" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveData_di" bpmnElement="Task_SaveData">
        <dc:Bounds x="1030" y="455" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_StoreInDB_di" bpmnElement="Task_StoreInDB">
        <dc:Bounds x="1030" y="625" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateIndexes_di" bpmnElement="Task_CreateIndexes">
        <dc:Bounds x="1180" y="625" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FetchFromDB_di" bpmnElement="Task_FetchFromDB">
        <dc:Bounds x="1030" y="625" width="100" height="80" />
